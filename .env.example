# Database
DATABASE_URL="postgresql://user:password@localhost:5432/knowledge_clipper"

# Encryption secret for API keys stored in DB (generate with: openssl rand -hex 32)
ENCRYPTION_SECRET="your-random-secret-here"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 可选：公开演示账号的用户名。未登录用户访问首页/知识库/日报时，
# 看到的将是这个账号的（只读）数据。写操作（clip、settings）仍要求登录。
DEMO_USERNAME=""

# --- Below are OPTIONAL fallbacks (prefer using the Settings page instead) ---
# LLM settings are now managed through the web UI (/settings)
# These env vars only serve as fallback if the database is not yet configured.
# CHEAP_MODEL_BASE_URL="https://api.deepseek.com/v1"
# CHEAP_MODEL_API_KEY=""
# CHEAP_MODEL_NAME="deepseek-chat"
# STRONG_MODEL_BASE_URL="https://api.deepseek.com/v1"
# STRONG_MODEL_API_KEY=""
# STRONG_MODEL_NAME="deepseek-chat"
# EMBEDDING_MODEL_BASE_URL="https://api.deepseek.com/v1"
